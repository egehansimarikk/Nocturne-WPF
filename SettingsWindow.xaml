<Window x:Class="Nocturne.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nocturne Settings"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#141418"
        Foreground="#F2F2F7">

    <Border Padding="20" Background="#141418">
        <StackPanel>
            <!-- Ses Motoru Modu -->
            <TextBlock x:Name="AudioEngineLabel" Text="Ses Motoru Modu" FontSize="13" FontWeight="SemiBold" Foreground="#D0D0DC" Margin="0,0,0,6"/>
            <ComboBox x:Name="EngineComboBox" Height="30" Padding="8,4" Margin="0,0,0,10"
                      SelectionChanged="EngineComboBox_SelectionChanged"/>

            <!-- Ses Çıkış Cihazı -->
            <TextBlock x:Name="AudioOutputLabel" Text="Ses Çıkış Cihazı" FontSize="13" FontWeight="SemiBold" Foreground="#D0D0DC" Margin="0,0,0,6"/>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="DeviceComboBox" Grid.Column="0" Height="30" Padding="8,4" DisplayMemberPath="Label"
                          SelectionChanged="DeviceComboBox_SelectionChanged"/>
                <Button x:Name="RefreshBtn" Grid.Column="1" Content="Yenile" Margin="8,0,0,0" Padding="12,0" Height="30"
                        Background="#23232C" Foreground="#E4E4EE" BorderBrush="#32323E" Click="RefreshBtn_Click"/>
            </Grid>

            <TextBlock x:Name="WasapiNoteText" TextWrapping="Wrap" FontSize="11" Foreground="#9A9AB0" Margin="0,0,0,8" Visibility="Collapsed"/>

            <!-- 10-Bant Ekolayzır & DSP -->
            <Border Background="#1A1A21" BorderBrush="#2A2A36" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,2,0,12">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock x:Name="EqSectionLabel" Text="10-Bant Ekolayzır &amp; DSP" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="#D8D8E6" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                        <ComboBox x:Name="EqPresetComboBox" Width="165" Height="26" Padding="6,2" DockPanel.Dock="Right"
                                  SelectionChanged="EqPresetComboBox_SelectionChanged"/>
                    </DockPanel>

                    <CheckBox x:Name="EqEnableCheck" Content="Ekolayzırı Etkinleştir" Foreground="#E4E4EE" FontSize="11.5" Margin="0,0,0,4"/>
                    <CheckBox x:Name="AutoDeviceEqCheck" Content="Her ses cihazı için kendi EQ profilini hatırla" Foreground="#C8C8D8" FontSize="11.5" Margin="0,0,0,4"/>
                    <CheckBox x:Name="VolumeNormCheck" Content="Ses Normalizasyonu ve Yumuşak Limiter (Parça seviyesi dengeleme)" Foreground="#C8C8D8" FontSize="11.5" Margin="0,0,0,4"/>
                    <CheckBox x:Name="VisualizerCheck" Content="Üst barda canlı FFT spektrum analizörünü göster" Foreground="#C8C8D8" FontSize="11.5" Margin="0,0,0,8"/>

                    <UniformGrid x:Name="EqBandsGrid" Columns="10" Height="112"/>
                </StackPanel>
            </Border>

            <!-- Arayüz Dili -->
            <TextBlock x:Name="LanguageLabel" Text="Arayüz Dili" FontSize="13" FontWeight="SemiBold" Foreground="#D0D0DC" Margin="0,0,0,6"/>
            <ComboBox x:Name="LanguageComboBox" Height="30" Padding="8,4" Margin="0,0,0,10"
                      SelectionChanged="LanguageComboBox_SelectionChanged"/>

            <!-- Sistem ve Bildirimler -->
            <TextBlock x:Name="CloseBehaviorLabel" Text="Sistem ve Bildirimler" FontSize="13" FontWeight="SemiBold" Foreground="#D0D0DC" Margin="0,0,0,6"/>
            <CheckBox x:Name="MinimizeToTrayCheck" Content="Pencere kapatıldığında (X) sistem tepsisine küçült"
                      Foreground="#E4E4EE" FontSize="12" Margin="0,0,0,4"/>
            <CheckBox x:Name="TrackOsdCheck" Content="Arka planda şarkı değişince ekran bildirimi (OSD) göster"
                      Foreground="#E4E4EE" FontSize="12" Margin="0,0,0,4"/>
            <CheckBox x:Name="DiscordRpcCheck" Content="Discord Rich Presence (Dinlenen şarkıyı profilde göster)"
                      Foreground="#E4E4EE" FontSize="12" Margin="0,0,0,4"/>
            <CheckBox x:Name="UpdateCheckBox" Content="Açılışta GitHub üzerinden yeni sürüm kontrol et"
                      Foreground="#E4E4EE" FontSize="12" Margin="0,0,0,10"/>

            <!-- Global Kısayollar -->
            <TextBlock x:Name="HotkeysLabel" Text="Global Medya Kısayolları (Tıkla ve Tuşa Bas)" FontSize="13" FontWeight="SemiBold" Foreground="#D0D0DC" Margin="0,0,0,6"/>
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="HotkeyPlayLabel" Grid.Row="0" Grid.Column="0" Text="Oynat / Duraklat:" VerticalAlignment="Center" FontSize="12" Foreground="#C8C8D6"/>
                <TextBox x:Name="PlayHotkeyBox" Grid.Row="0" Grid.Column="1" Height="25" Padding="8,3" IsReadOnly="True" Cursor="Hand"
                         Background="#1D1D24" Foreground="#D475FF" BorderBrush="#32323E" FontWeight="SemiBold"
                         GotFocus="HotkeyBox_GotFocus" LostFocus="HotkeyBox_LostFocus" PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>

                <TextBlock x:Name="HotkeyNextLabel" Grid.Row="1" Grid.Column="0" Text="Sonraki Parça:" VerticalAlignment="Center" FontSize="12" Foreground="#C8C8D6"/>
                <TextBox x:Name="NextHotkeyBox" Grid.Row="1" Grid.Column="1" Height="25" Padding="8,3" IsReadOnly="True" Cursor="Hand"
                         Background="#1D1D24" Foreground="#D475FF" BorderBrush="#32323E" FontWeight="SemiBold"
                         GotFocus="HotkeyBox_GotFocus" LostFocus="HotkeyBox_LostFocus" PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>

                <TextBlock x:Name="HotkeyPrevLabel" Grid.Row="2" Grid.Column="0" Text="Önceki Parça:" VerticalAlignment="Center" FontSize="12" Foreground="#C8C8D6"/>
                <TextBox x:Name="PrevHotkeyBox" Grid.Row="2" Grid.Column="1" Height="25" Padding="8,3" IsReadOnly="True" Cursor="Hand"
                         Background="#1D1D24" Foreground="#D475FF" BorderBrush="#32323E" FontWeight="SemiBold"
                         GotFocus="HotkeyBox_GotFocus" LostFocus="HotkeyBox_LostFocus" PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>
            </Grid>

            <!-- Kaydet / İptal -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelBtn" Content="İptal" Width="88" Height="32" Margin="0,0,10,0"
                        Background="#23232C" Foreground="#D4D4E0" BorderBrush="#32323E" Click="CancelBtn_Click"/>
                <Button x:Name="SaveBtn" Content="Kaydet ve Uygula" Width="136" Height="32"
                        Background="#A238FF" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Click="SaveBtn_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>