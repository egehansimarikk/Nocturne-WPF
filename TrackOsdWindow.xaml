<Window x:Class="Nocturne.TrackOsdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="330"
        Height="78"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        IsHitTestVisible="False"
        ResizeMode="NoResize">

    <Border x:Name="CardBorder"
            CornerRadius="12"
            Background="#E814141A"
            BorderBrush="#44A238FF"
            BorderThickness="1.2"
            Padding="10"
            Opacity="0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Color="#000000" Opacity="0.65"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="54"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="54" Height="54" CornerRadius="8" Background="#22222C" ClipToBounds="True">
                <Image x:Name="CoverImg" Stretch="UniformToFill"/>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,4,0">
                <TextBlock Text="NOCTURNE" FontSize="9.5" FontWeight="Bold" Foreground="#B45AFF"/>
                <TextBlock x:Name="TitleText" Text="Track Title" FontSize="13.5" FontWeight="SemiBold"
                           Foreground="#F5F5FA" TextTrimming="CharacterEllipsis" Margin="0,2,0,1"/>
                <TextBlock x:Name="ArtistText" Text="Artist" FontSize="11.5"
                           Foreground="#A6A6BC" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>