<Window x:Class="Nocturne.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Nocturne"
        Height="760"
        Width="1280"
        Background="#0F0F12"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#0F0F12">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#121216" BorderBrush="#1F1F26" BorderThickness="0,0,0,1" Padding="12,0">
            <DockPanel LastChildFill="False">
                <TextBlock Text="NOCTURNE" VerticalAlignment="Center" FontSize="11" FontWeight="Bold"
                           Foreground="#8E8E9E" DockPanel.Dock="Left"/>
                <Button x:Name="SettingsBtn" DockPanel.Dock="Right" Content="⚙" Width="30" Height="24"
                        Background="Transparent" Foreground="#C8C8D4" BorderThickness="0"
                        FontSize="14" Cursor="Hand" Click="SettingsBtn_Click"/>
                <Button x:Name="MiniPlayerBtn" DockPanel.Dock="Right" Content="⧉" Width="30" Height="24" Margin="0,0,2,0"
                        Background="Transparent" Foreground="#C8C8D4" BorderThickness="0"
                        FontSize="13" Cursor="Hand" Click="MiniPlayerBtn_Click"/>
            </DockPanel>
        </Border>

        <wv2:WebView2 x:Name="DeezerWebView" Grid.Row="1" DefaultBackgroundColor="#0F0F12"/>
    </Grid>
</Window>