<Window x:Class="Nocturne.MiniPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nocturne Mini"
        Width="280"
        Height="140"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Border x:Name="RootBorder" Background="#F214141A" BorderBrush="#2C2C38" BorderThickness="1" CornerRadius="12" Padding="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Üst Kısım: Albüm Kapağı, Şarkı Bilgisi ve Pencere Butonları -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="52" Height="52" CornerRadius="8" Background="#22222C" ClipToBounds="True">
                    <Image x:Name="CoverImage" Stretch="UniformToFill"/>
                </Border>

                <StackPanel Grid.Column="1" Margin="10,2,6,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Text="Nocturne" FontSize="13" FontWeight="SemiBold"
                               Foreground="#F4F4F8" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="ArtistText" Text="Deezer" FontSize="11"
                               Foreground="#9898A8" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button x:Name="ClickThroughBtn" Content="📌" Width="22" Height="22" Margin="0,0,2,0"
                            Background="Transparent" Foreground="#B0B0C0" BorderThickness="0"
                            FontSize="11" Cursor="Hand" Click="ClickThroughBtn_Click"/>
                    <Button x:Name="ExpandBtn" Content="⤢" Width="22" Height="22" Margin="0,0,2,0"
                            Background="Transparent" Foreground="#B0B0C0" BorderThickness="0"
                            FontSize="12" Cursor="Hand" Click="ExpandBtn_Click"/>
                    <Button x:Name="CloseBtn" Content="✕" Width="22" Height="22"
                            Background="Transparent" Foreground="#B0B0C0" BorderThickness="0"
                            FontSize="11" Cursor="Hand" Click="CloseBtn_Click"/>
                </StackPanel>
            </Grid>

            <!-- Orta Kısım: İlerleme / Sarma Çubuğu -->
            <Slider x:Name="SeekSlider" Grid.Row="1" Minimum="0" Maximum="100" Value="0"
                    Margin="0,8,0,4" IsMoveToPointEnabled="True" Cursor="Hand"
                    PreviewMouseLeftButtonDown="SeekSlider_MouseDown"
                    PreviewMouseLeftButtonUp="SeekSlider_MouseUp"/>

            <!-- Alt Kısım: Oynatma Kontrolleri -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button x:Name="PrevBtn" Content="⏮" Width="34" Height="28"
                        Background="Transparent" Foreground="#E4E4EE" BorderThickness="0"
                        FontSize="14" Cursor="Hand" Click="PrevBtn_Click"/>
                <Button x:Name="PlayPauseBtn" Content="▶" Width="38" Height="30" Margin="10,0"
                        Background="#A238FF" Foreground="White" BorderThickness="0"
                        FontSize="13" FontWeight="Bold" Cursor="Hand" Click="PlayPauseBtn_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="15"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button x:Name="NextBtn" Content="⏭" Width="34" Height="28"
                        Background="Transparent" Foreground="#E4E4EE" BorderThickness="0"
                        FontSize="14" Cursor="Hand" Click="NextBtn_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>